# ============================================================
# Skillcraft Backend — .env
# Это твои реальные данные. НЕ публикуй этот файл в GitHub!
# ============================================================

PORT=3000
NODE_ENV=development

# URL-адреса (замени после деплоя)
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5500

# ─── ЦЕНА КУРСА ────────────────────────────────────────────
# В тийинах (UZS × 100). 99 000 UZS = 9 900 000 тийин
# ⚠️ ЗАМЕНИ НА СВОЮ ЦЕНУ
COURSE_PRICE_TIYIN=5400000
COURSE_PRICE_DISPLAY=54 000 UZS

# ─── CLICK ─────────────────────────────────────────────────
# Мерчант: YaTT "HAMDAMOV ASILBEK HASANOVICH"
# Домен: skillcraft.uz
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
CLICK_SECRET_KEY=YOUR_CLICK_SECRET_KEY
CLICK_MERCHANT_USER_ID=YOUR_CLICK_MERCHANT_USER_ID

# Callback URLs — замени localhost на реальный домен после деплоя
CLICK_CALLBACK_URL=http://localhost:3000/api/payments/click/prepare
CLICK_RETURN_URL=http://localhost:5500/success.html

# ─── PAYME ─────────────────────────────────────────────────
# ⚠️ Вставь когда получишь данные от Payme
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_SECRET_KEY=YOUR_PAYME_SECRET_KEY
PAYME_TEST_KEY=YOUR_PAYME_TEST_KEY
PAYME_CALLBACK_URL=http://localhost:3000/api/payments/payme/callback
PAYME_RETURN_URL=http://localhost:5500/success.html

# ─── JWT ───────────────────────────────────────────────────
# ⚠️ Замени на случайную строку минимум 32 символа
JWT_SECRET=хК9#mNpQ2$vLxRt7@wYsД8еЖ3фЦу5бН
JWT_EXPIRES_IN=30d

# ─── DATABASE ──────────────────────────────────────────────
DB_PATH=./db/skillcraft.sqlite
